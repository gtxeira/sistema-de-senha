{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxc_formatter/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "sortImports": false,
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".github/**",
    "docs/**",
    "**/*.md",
    "compose*.yaml",
    "prisma/migrations/**",
    "skills-lock.json",
    "components.json",
    "next-env.d.ts",
    "bun.lock",
    ".next/**",
    "out/**",
    "build/**",
    "dist-electron/**",
    "coverage/**",
    "src/server/generated/**"
  ]
}
