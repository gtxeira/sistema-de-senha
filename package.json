{
  "name": "sistema-de-senha",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "preinstall": "npx only-allow bun",
    "postinstall": "prisma generate",
    "dev": "bun --inspect=0.0.0.0:9229 --bun ./node_modules/next/dist/bin/next dev",
    "build": "prisma generate && next build",
    "start": "bun .next/standalone/server.js",
    "lint": "eslint .",
    "lint:type-aware": "eslint . --config eslint.config.type-aware.mjs",
    "lint:oxlint": "oxlint",
    "lint:oxlint:type-aware": "oxlint --type-aware --tsconfig tsconfig.json",
    "lint:oxlint:fix": "bun scripts/lint-fix.mjs",
    "format:oxfmt": "oxfmt",
    "format:oxfmt:check": "oxfmt --check",
    "build:electron": "bun build main.ts --outdir=dist-electron --format=esm --target=node --external electron",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:changed": "vitest --changed",
    "test:failed": "vitest --onlyFailed",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run",
    "electron:dev": "bun run build:electron && electron .",
    "dist": "bun run build:electron && electron-builder --win nsis",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:migrate:test": "dotenv -e .env.test -o -- prisma migrate dev && prisma generate",
    "db:seed:test": "dotenv -e .env.test -o -- prisma db seed",
    "db:reset:test": "dotenv -e .env.test -o -- prisma migrate reset --force && dotenv -e .env.test -o -- prisma db seed",
    "garage:setup": "bun scripts/setup-garage.js",
    "garage:clear": "bun scripts/clear-garage.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv-cli": "^11",
    "electron": "^44",
    "electron-builder": "26.17.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-perfectionist": "5.13.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "trustedDependencies": [
    "electron"
  ],
  "build": {
    "appId": "com.sistemasenha.app",
    "productName": "Sistema de Senhas",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.svg"
    }
  }
}
