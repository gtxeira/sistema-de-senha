
# ── Postgres local (Docker) ──────────────────────────────────────
POSTGRES_DB=sistemadesenha
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistemadesenha?schema=public"

# ── Camada de dados ──────────────────────────────────────────────
# "supabase" (default) ou "postgres"
# Quando "postgres": auth, users, news, queue, read usam Prisma
# Realtime usa SSE (Server-Sent Events) — não depende de backend
DATA_LAYER="postgres"

# ── Auth.js ──────────────────────────────────────────────────────
AUTH_SECRET="gere-um-secret-com-openssl-rand-base64-32"

# ── Supabase (apenas quando DATA_LAYER="supabase") ───────────────
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-publicavel"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-secreta"