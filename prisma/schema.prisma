generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────

enum queue_type {
  normal
  preferencial
}

// ── Cargos e permissões (RBAC) ─────────────────────────────────
// As chaves de permissão em si são um registro fixo em
// `src/lib/permissions.js` — aqui ficam apenas as atribuições
// cargo→permissão e usuário→permissão (overrides).

model roles {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  // Cargo criado pelo sistema (admin/attendant): não editável nem removível.
  built_in    Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  permissions role_permissions[]
  users       users[]
}

model role_permissions {
  permission String
  role_id    String    @db.Uuid

  role roles @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission])
}

model user_permissions {
  permission String
  // true = concede além do cargo; false = nega mesmo que o cargo conceda.
  granted    Boolean   @default(true)
  user_id    String    @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, permission])
}

// ── Refresh tokens (sessão de curta duração) ───────────────────
// Guarda apenas o SHA-256 do token opaco emitido no login. Cada rotação
// marca a linha atual como `used_at` e insere a nova na mesma família;
// reapresentar um token já usado (fora da janela de graça) revoga a família.

model refresh_tokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  family_id  String    @db.Uuid
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([family_id])
  @@index([user_id])
}

// ── Tabela unificada de usuários (substitui auth.users + profiles) ──

model users {
  id            String    @id @default(uuid()) @db.Uuid
  username      String    @unique
  email         String    @unique
  password_hash String
  full_name     String
  role_id       String    @db.Uuid
  sector_id     String?
  guiche_id     String    @default("none")
  active        Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  role            roles             @relation(fields: [role_id], references: [id])
  sectors         sectors?          @relation(fields: [sector_id], references: [id])
  permissions     user_permissions[]
  refresh_tokens  refresh_tokens[]
  queue_calls     queue_calls[]
}

// ── Setores ────────────────────────────────────────────────────

model sectors {
  id             String          @id
  name           String
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  // Marcador de reset da fila do setor. Os clientes comparam este valor com o
  // último que viram para invalidar a réplica local quando o reset acontece em
  // outro dispositivo. Também delimita quais queue_calls são pós-reset.
  reset_at       DateTime?       @db.Timestamptz(6)
  users          users[]
  queue_calls    queue_calls[]
}

// ── Filas ──────────────────────────────────────────────────────

model queue_sequences {
  sector_id    String
  call_type    queue_type
  current_number Int    @default(0)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@id([sector_id, call_type])
}

// ── Chamadas de fila ───────────────────────────────────────────

model queue_calls {
  id         String    @id @default(uuid()) @db.Uuid
  sector_id  String
  number_str String    @db.VarChar(4)
  number_int Int
  type       queue_type
  called_by  String?   @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  sectors sectors @relation(fields: [sector_id], references: [id])
  users   users?  @relation(fields: [called_by], references: [id])
}

// ── Notícias ───────────────────────────────────────────────────

model news {
  id         BigInt    @id @default(autoincrement())
  title      String
  image_url  String
  active     Boolean   @default(true)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}
