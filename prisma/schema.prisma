generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────

enum user_role {
  admin
  attendant
}

enum queue_type {
  normal
  preferencial
}

// ── Tabela unificada de usuários (substitui auth.users + profiles) ──

model users {
  id            String    @id @default(uuid()) @db.Uuid
  username      String    @unique
  email         String    @unique
  password_hash String
  full_name     String
  role          user_role @default(attendant)
  sector_id     String?
  guiche_id     String    @default("none")
  active        Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  sectors     sectors?      @relation(fields: [sector_id], references: [id])
  settings    settings?
  queue_calls queue_calls[]
}

// ── Setores ────────────────────────────────────────────────────

model sectors {
  id             String          @id
  name           String
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  users          users[]
  queue          queues?
  queue_calls    queue_calls[]
  queue_counters queue_counters?
}

// ── Filas ──────────────────────────────────────────────────────

model queues {
  sector_id      String    @id
  current_number Int       @default(0)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  sectors        sectors   @relation(fields: [sector_id], references: [id])
}

model queue_counters {
  sector_id      String    @id
  current_number Int?      @default(0)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  sectors        sectors   @relation(fields: [sector_id], references: [id])
}

model queue_sequences {
  sector_id    String
  call_type    queue_type
  current_number Int    @default(0)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@id([sector_id, call_type])
}

// ── Chamadas de fila ───────────────────────────────────────────

model queue_calls {
  id         String    @id @default(uuid()) @db.Uuid
  sector_id  String
  number_str String    @db.VarChar(4)
  number_int Int
  type       queue_type
  called_by  String?   @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  sectors sectors @relation(fields: [sector_id], references: [id])
  users   users?  @relation(fields: [called_by], references: [id])
}

// ── Configurações do usuário ───────────────────────────────────

model settings {
  user_id       String  @id @db.Uuid
  sound_enabled Boolean @default(true)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ── Notícias ───────────────────────────────────────────────────

model news {
  id         BigInt    @id @default(autoincrement())
  title      String
  image_url  String
  active     Boolean   @default(true)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}
